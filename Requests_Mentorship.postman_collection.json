{
  "info": {
    "name": "Requests & Mentorship API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "PASTE_USER_A_JWT (requester / mentee)"
    },
    {
      "key": "ownerToken",
      "value": "PASTE_USER_B_JWT (resource owner / mentor)"
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "mentorId",
      "value": ""
    },
    {
      "key": "mentorshipRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Resource Requests (use token = User A, ownerToken = User B)",
      "item": [
        {
          "name": "Create request (A -> B resource)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": \"{{resourceId}}\",\n  \"message\": \"Can I borrow this?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            }
          }
        },
        {
          "name": "Create request - own resource (expect 400, use ownerToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": \"{{resourceId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            }
          }
        },
        {
          "name": "Create duplicate (expect 409)",
          "request": {
            "method": "POST",
