# true  = run on built-in sample data (no backend needed). Use this while building pages.
# false = talk to the real Express API.
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false.
# In dev, leave as /api (Vite proxies it to http://localhost:5000).
# On Vercel, set this to your Render URL, e.g. https://resourceloop-api.onrender.com/api
VITE_API_URL=/api
